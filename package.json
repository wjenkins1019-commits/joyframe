{
  "name": "joyframe",
  "version": "1.0.2",
  "description": "JOYFRAME - Every Game. One Universe.",
  "main": "./out/main/index.js",
  "author": "965 Media",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wjenkins1019-commits/joyframe.git"
  },
  "engines": {
    "node": ">=26"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/build-fresh.mjs",
    "start": "electron-vite preview",
    "postinstall": "node node_modules/electron/install.js",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "smoke": "node scripts/smoke.ts",
    "icons": "node scripts/gen-icons.mjs",
    "verify:icons": "node scripts/gen-icons.mjs --check",
    "dist": "npm run build && electron-builder --win nsis --publish never",
    "predist": "npm run verify:icons",
    "verify:pad": "node scripts/verify-pad.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "verify:dist-pad": "node scripts/verify-pad.mjs --dist",
    "verify:first-run": "node scripts/verify-first-run.mjs",
    "verify:intro": "node scripts/verify-intro.mjs && node scripts/verify-intro-first-run.ts",
    "verify:intro-ui": "node scripts/verify-intro-ui.ts",
    "verify:intro-pad": "node scripts/verify-intro-pad.ts",
    "verify:intro-name-pad": "node scripts/verify-intro-name-pad.ts",
    "verify:installer": "node scripts/check-installer.mjs",
    "verify:installer-matrix": "node scripts/verify-installer-matrix.mjs",
    "verify:update-channels": "node scripts/verify-update-channels.mjs",
    "verify:signature": "node scripts/verify-signature.mjs",
    "verify:signing": "node scripts/verify-signing-readiness.mjs",
    "verify:installed-build": "node scripts/verify-installed-build.mjs",
    "verify:installed": "node scripts/verify-installed-build.mjs && node scripts/verify-installed.mjs",
    "verify:freshness": "node scripts/check-packaged-fresh.mjs",
    "self-test": "node scripts/self-test.mjs && node scripts/self-test-workflow.mjs",
    "self-test:workflow": "node scripts/self-test-workflow.mjs",
    "check": "npm run typecheck && npm run self-test && npm run verify:icons && npm run smoke && npm run verify:freshness && npm run verify:pad && npm run verify:intro && npm run verify:intro-ui && npm run verify:intro-pad && node scripts/report-packaged-freshness.mjs",
    "check:installed": "npm run check && npm run verify:installed-build",
    "certify": "node scripts/certify.mjs"
  },
  "build": {
    "appId": "com.joyframe.launcher",
    "productName": "JOYFRAME",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "JOYFRAME"
    },
    "publish": {
      "provider": "github"
    },
    "mac": {
      "icon": "resources/icon-512.png",
      "category": "public.app-category.games"
    },
    "linux": {
      "icon": "resources/icon-512.png",
      "category": "Game"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "hls.js": "^1.7.4",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "js-yaml": "^4.3.2",
    "png-to-ico": "^3.0.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
